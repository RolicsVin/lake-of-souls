[sub_resource type="GDScript" id="GDScript_rcqid"]
resource_name = "continio"
script/source = "extends GTButton

@export var strength: float = 10.0
@export var smoothness: float = 8.0

var start_position: Vector2
var target_position: Vector2

var pressed_: bool = false


func _ready() -> void:
	super._ready()
	
	pressed.connect(press)
	
	start_position = position
	target_position = position


func press():
	pressed_ = true


func _process(delta: float) -> void:
	super._process(delta)
	
	var viewport_size := get_viewport_rect().size
	var mouse_position := get_viewport().get_mouse_position()
	
	# Переводим положение мыши в диапазон от -1 до 1
	var mouse_offset := (mouse_position / viewport_size) * 2.0 - Vector2.ONE
	
	# Целевая позиция объекта
	target_position = start_position + mouse_offset * strength
	
	# Плавное движение
	position = position.lerp(target_position, smoothness * delta)
	
	if pressed_:
		return
	
	if is_hovered():
		$AnimationPlayer.play(\"hovered\", 0.5)
	else:
		$AnimationPlayer.play(\"state\", 0.5)


func _pressed() -> void:
	super._pressed()
	hide()
"

