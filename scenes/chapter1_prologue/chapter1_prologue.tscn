[sub_resource type="GDScript" id="GDScript_r2e7w"]
resource_name = "node"
script/source = "extends Node


func _on_chat_replica_started(replica: Replica) -> void:
	if replica.get_unical_id() == 'start_replica':
		Core.save()


func _on_chat_replica_ended(replica: Replica) -> void:
	if replica.get_unical_id() == 'last':
		Core.save()
		
		await get_tree().create_timer(15).timeout
		
		GodoTools.change_scene(\"res://scenes/chapter1_prologue/chapter_1.tscn\")
"

